    "test:changes": "tsx tests/schedule-changes-audit.ts",
    "test:report-approval": "tsx tests/report-approval-audit.ts",
    "test:approval-integrity": "tsx tests/approval-integrity-audit.ts",
    "test:relay-fixes": "tsx tests/relay-fixes-audit.ts",
    "test:inbox-ask": "tsx tests/inbox-ask-audit.ts",
    "test:instructor-request": "tsx tests/instructor-request-audit.ts",
    "test:instructor-request-server": "tsx tests/instructor-request-server-audit.ts",
    "test:student-case-status": "tsx tests/student-case-status-audit.ts",
    "test:student-registration": "tsx tests/student-registration-audit.ts",
    "test:print-attestation": "tsx tests/print-attestation-audit.ts",
