  "dependencies": {
    "@google-cloud/firestore": "^8.7.1",
    "@napi-rs/canvas": "^1.0.7",
    "@types/compression": "^1.8.1",
    "@vitejs/plugin-react": "^5.0.4",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.0",
    "firebase": "^12.17.1",
