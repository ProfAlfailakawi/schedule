    "test:changes-baseline": "tsx tests/changes-baseline-audit.ts",
    "test:instructor-request-followup": "tsx tests/instructor-request-followup-audit.ts",
    "test:data": "python3 tests/legacy-data-audit.py",
    "test:credentials": "tsx tests/credential-audit.ts",
    "test:parity": "python3 tests/parity_audit.py",
