{
  "name": "schedule-academic-workspace",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/stamp-build.mjs --ensure && tsx server.ts",
    "build": "npm run audit:brand && npm run audit:guide && npm run test:guide && npm run test:guide:perf && node scripts/stamp-build.mjs && vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs && node scripts/stamp-sw.mjs",
    "start": "NODE_ENV=production node dist/server.cjs",
    "test": "npm run test:locations && npm run test:pdf-import && npm run test:gemini-layer && npm run test:conflicts && npm run test:behavior && npm run test:data && npm run test:credentials && npm run test:parity",
    "test:behavior": "tsx tests/run-tests.ts",
    "test:data": "python3 tests/legacy-data-audit.py",
    "test:credentials": "tsx tests/credential-audit.ts",
    "test:parity": "python3 tests/parity_audit.py",
    "clean": "rm -rf dist server.js",
    "lint": "node scripts/stamp-build.mjs --ensure && tsc --noEmit",
    "protect:data": "node scripts/protect-private-state.mjs",
    "extract:legacy": "python3 scripts/extract-legacy-bak.py",
    "migrate:firestore": "tsx scripts/import-legacy-json.ts database/db.json.gz",
    "migrate:firestore:replace": "tsx scripts/import-legacy-json.ts database/db.json.gz --replace",
    "audit:deploy": "node scripts/deployment-audit.mjs",
    "gcp-build": "npm run build",
    "audit:guide": "node scripts/guide-audit.mjs",
    "test:guide": "node scripts/guide-behavior-tests.mjs",
    "test:guide:perf": "node scripts/guide-performance-audit.mjs",
    "test:gemini-layer": "tsx tests/gemini-schedule-layer.ts",
    "test:conflicts": "tsx tests/conflict-parity.ts",
    "test:locations": "python3 tests/location-registry-audit.py",
    "test:pdf-import": "tsx tests/pdf-import-regression.ts && tsx tests/pdf-import-golden.ts",
    "audit:brand": "node scripts/render-brand.mjs --check",
    "brand": "node scripts/render-brand.mjs"
  },
  "dependencies": {
    "@google-cloud/firestore": "^8.7.1",
    "@napi-rs/canvas": "^1.0.7",
    "@types/compression": "^1.8.1",
    "@vitejs/plugin-react": "^5.0.4",
    "compression": "^1.8.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "firebase": "^12.17.1",
    "firebase-admin": "^14.2.0",
    "google-auth-library": "^11.0.0",
    "heic-decode": "^2.1.0",
    "lucide-react": "^0.546.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "tesseract.js": "^7.0.0",
    "vite": "^6.2.3",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "esbuild": "^0.25.0",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  },
  "engines": {
    "node": ">=20"
  }
}
