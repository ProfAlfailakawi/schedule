# Source-deploy ignore list for Cloud Run: the upload contains the application source and the compact bootstrap snapshot only.
# Version control metadata, dependencies, build output, archives, logs and the uncompressed database snapshot are excluded.
.git/
!Dockerfile
.github/
node_modules/
dist/
*.zip
*.log
.DS_Store
database/db.json
# database/db.json.gz is intentionally deployed as the verified bootstrap snapshot.
