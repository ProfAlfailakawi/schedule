# Local development default. Cloud Run is forced to production mode at runtime.
NODE_ENV=development
PORT=3000

# REQUIRED FOR SAFE DEPLOYMENTS:
# Keep .env, db.json and the vault key outside the application directory so replacing
# an uploaded release can never delete runtime data. Prefer an absolute persistent path.
# If omitted, the app uses the sibling directory ../schedule-private.
# SCHEDULE_PRIVATE_DIR=/absolute/persistent/path/schedule-private

# Local parity mode. The bundled source snapshot may be compressed as database/db.json.gz.
DATA_MODE=demo

# Production / Cloud Run mode (Cloud Run also promotes demo -> firestore automatically):
# DATA_MODE=firestore
# FIREBASE_PROJECT_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/to/service-account.json

# On an intentionally empty Firestore test database, import the verified Legacy snapshot before accepting logins.
AUTO_IMPORT_LEGACY_DATA=true

# Legacy SystemUser screen compatibility:
# The old screen displays and edits the existing password value. The rebuild stores authentication hashes
# separately and keeps that display/edit value AES-256-GCM encrypted. In production prefer this secret as an
# environment variable instead of the bundled private test key file.
# PASSWORD_VAULT_KEY=<64 hex characters or base64-encoded 32-byte key>

# Optional local Firestore Emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Cloud Run note: runtime scratch files use /tmp only; durable schedule data must live in Firestore.
