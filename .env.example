# Local development default. Cloud Run is forced to production mode at runtime.
NODE_ENV=development
PORT=3000

# REQUIRED FOR SAFE DEPLOYMENTS:
# Keep .env, db.json and the vault key outside the application directory so replacing
# an uploaded release can never delete runtime data. Prefer an absolute persistent path.
# If omitted, the app uses the sibling directory ../schedule-private.
# SCHEDULE_PRIVATE_DIR=/absolute/persistent/path/schedule-private

# البيانات الحقيقية هي الوضع الافتراضي.
# اترك DATA_MODE فارغاً أو احذفه تماماً = Firestore (بيانات الجامعة).
# إذا تعذر الاتصال بـ Firestore يتوقف التشغيل برسالة واضحة، ولا يعمل على بيانات بديلة.
# DATA_MODE=firestore
FIREBASE_PROJECT_ID=
FIREBASE_DATABASE_ID=
# GOOGLE_APPLICATION_CREDENTIALS=/absolute/private/path/to/service-account.json

# بيانات تجريبية للتطوير فقط — تُطلب صراحةً، وتُعلَن في السجل عند كل تشغيل.
# لا تستخدمها على خادم يراه المستخدمون.
# DATA_MODE=demo

# On an intentionally empty Firestore test database, import the verified Legacy snapshot before accepting logins.
AUTO_IMPORT_LEGACY_DATA=true

# Legacy SystemUser screen compatibility:
# The old screen displays and edits the existing password value. The rebuild stores authentication hashes
# separately and keeps that display/edit value AES-256-GCM encrypted. In production prefer this secret as an
# environment variable instead of the bundled private test key file.
# PASSWORD_VAULT_KEY=<64 hex characters or base64-encoded 32-byte key>

# Optional local Firestore Emulator:
# FIRESTORE_EMULATOR_HOST=127.0.0.1:8080

# Cloud Run note: runtime scratch files use /tmp only; durable schedule data must live in Firestore.

# Optional Smart Guide intent adapter. The app uses deterministic Arabic/Kuwaiti
# parsing first and calls this endpoint only for low-confidence/compound requests.
# The adapter must accept the documented minimal JSON payload and return { intent }.
GUIDE_AI_ENDPOINT=
GUIDE_AI_BEARER_TOKEN=
GUIDE_AI_MODEL=

# Native OpenAI fallback for Smart Guide. If GUIDE_AI_ENDPOINT is empty and
# OPENAI_API_KEY is configured, /api/guide/intent uses the Responses API only
# for low-confidence or compound questions. Raw click history is never sent.
OPENAI_API_KEY=
OPENAI_GUIDE_MODEL=gpt-5-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional public production entry to the dedicated isolated Demo Cloud Run service.
# Keep the main service on Firestore; the Demo service itself must run with SCHEDULE_DEMO_SERVICE=true.
# SCHEDULE_DEMO_URL=https://<dedicated-demo-service-url>
