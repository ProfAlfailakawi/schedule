rules_version = '2';

/**
 * لا يدخل أحد من هذا الباب.
 *
 * The only client this database has is the application server, and it speaks
 * through the Firebase Admin SDK — which bypasses these rules entirely. So the
 * correct rule for every direct browser/SDK connection is: no.
 *
 * The previous rule (`if request.auth != null`) read as "authenticated users
 * only", which sounds safe and is not: this project ships the client SDK, so
 * ANY identity Firebase would mint for this project — an anonymous sign-in, a
 * Google account, anything a leaked web API key allows — could read and rewrite
 * `users` (including the password vault), `sessions`, `schedules` and
 * `scheduleShareLinks` directly, walking straight past every permission and
 * scope check in server.ts.
 *
 * Nothing the application does breaks by closing this: the server's Admin SDK
 * credentials are not evaluated against these rules. If a future feature ever
 * needs direct client reads, it must arrive with its own narrow, collection-
 * scoped rule and a documented reason — never by widening this one.
 */
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
